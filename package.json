{
  "name": "orangehrm-test",
  "version": "1.0.0",
  "description": "Playwright QA automation project for OrangeHRM - best practices demo",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "npm run newman",
    "test:all": "npm run test && npm run newman",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "newman": "newman run postman/collection.json -e postman/env.json",
    "newman:report": "newman run postman/collection.json -e postman/env.json -r cli,htmlextra --reporter-htmlextra-export test-results/newman-report.html",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "codegen": "playwright codegen",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "allure-playwright": "^3.2.1",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-playwright": "^2.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "winston": "^3.17.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
