          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('Login accepted (200 or 302)', function () {",
                  "    pm.expect(code).to.be.oneOf([200, 302]);",
                  "});",
                  "if (code === 302) {",
