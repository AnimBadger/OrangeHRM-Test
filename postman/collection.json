    {
      "name": "Auth",
      "item": [
        {
          "name": "GET Login Page (store csrf_token for invalid login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const html = pm.response.text();",
                  "pm.test('Login page loads', function () { pm.response.to.have.status(200); });",
                  "const m = html.match(/:token=\"&quot;([^&]+)&quot;/);",
                  "if (m) { pm.collectionVariables.set('invalid_token', m[1]); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/web/index.php/auth/login",
              "host": ["{{base_url}}"],
              "path": ["web", "index.php", "auth", "login"]
            }
          }
        },
        {
          "name": "Login with Invalid Credentials (expect 302 to login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 (login page) for invalid creds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{invalid_token}}", "type": "text" },
                { "key": "username", "value": "wrong", "type": "text" },
                { "key": "password", "value": "wrong", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/web/index.php/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["web", "index.php", "auth", "validate"]
            }
          }
        },
