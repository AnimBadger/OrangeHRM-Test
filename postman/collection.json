                  "",
                  "pm.test('Status 200, user created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.userName).to.eql(pm.variables.get('new_username'));",
